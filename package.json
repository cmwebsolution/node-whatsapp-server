{
  "name": "shared-whatsapp-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "node scripts/test.mjs",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "migrate:production": "node --env-file-if-exists=.env dist/migrate.js",
    "provision": "tsx --env-file=.env src/provision.ts",
    "provision:production": "node --env-file-if-exists=.env dist/provision.js",
    "test:database": "RUN_DATABASE_TESTS=1 npm test",
    "probe": "node scripts/probe.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "backup": "node scripts/backup.mjs",
    "release:check": "node scripts/release-check.mjs",
    "capacity": "node scripts/capacity-suite.mjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "fastify": "5.12.5",
    "mysql2": "3.24.5",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/qrcode": "^1.5.5",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
