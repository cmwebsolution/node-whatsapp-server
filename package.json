{
  "name": "shared-whatsapp-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc && node --env-file-if-exists=.env scripts/install-browser.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "provision": "tsx --env-file=.env src/provision.ts",
    "provision:production": "node --env-file-if-exists=.env dist/provision.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.0"
  }
}
