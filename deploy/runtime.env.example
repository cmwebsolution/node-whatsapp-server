WHATSAPP_IMAGE=registry.example/whatsapp@sha256:REPLACE_WITH_VERIFIED_DIGEST
SECRET_DIRECTORY=/etc/whatsapp/secrets
# Resource allocations must be selected and measured on the target host.
NODE_MEMORY_LIMIT=
NODE_CPUS=
MYSQL_MEMORY_LIMIT=
MYSQL_CPUS=
SUPPORTED_SESSION_LIMIT=1
AUTH_ENCRYPTION_KEY_VERSION=v1
CONNECTION_CONCURRENCY=5
RESTORE_STAGGER_MS=100
MEDIA_REQUEST_CONCURRENCY=4
MEDIA_SEND_CONCURRENCY=2
