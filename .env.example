# Direct Node runs: local connections only by default.
HOST=127.0.0.1
PORT=3001
SESSION_DIR=./data/sessions
APP_CREDENTIALS_FILE=./data/applications.json
MAX_SESSIONS=20

# Docker Compose maps this loopback host port to container port 3001.
# Compose deliberately sets HOST=0.0.0.0 inside the container.
WHATSAPP_HOST_PORT=3001
# CHROME_PATH=/usr/bin/chromium
# CHROME_NO_SANDBOX=true

# Managed web apps: build automatically installs Chrome here.
# Defaults to a puppeteer directory beside APP_CREDENTIALS_FILE.
# Use an absolute persistent path shared by build and runtime on your host.
# PUPPETEER_CACHE_DIR=/private/persistent/whatsapp-data/puppeteer
PUPPETEER_SKIP_DOWNLOAD=false
