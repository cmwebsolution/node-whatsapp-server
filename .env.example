HOST=127.0.0.1
PORT=3001
MAX_SESSIONS=1
CONNECTION_CONCURRENCY=5
RESTORE_STAGGER_MS=100
MEDIA_REQUEST_CONCURRENCY=4
MEDIA_SEND_CONCURRENCY=2
SHUTDOWN_TIMEOUT_MS=30000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=whatsapp
DB_USER=whatsapp
DB_PASSWORD=
DB_POOL_SIZE=10
DB_TLS=false
AUTH_ENCRYPTION_KEY_VERSION=v1
# JSON map of version -> base64 encoded 32-byte key. Set through hosting secrets.
AUTH_ENCRYPTION_KEYS={}
# Only for provisioning; remove after provisioning. Same token goes into Laravel secrets.
# PROVISION_TOKEN=

# Separate versioned app event-signing secrets; never reuse bearer or auth encryption keys.
# {"app-id":{"current":"v1","keys":{"v1":"<base64 32-byte signing secret>"}}}
EVENT_SIGNING_KEYS={}

# Production may use DB_PASSWORD_FILE, AUTH_ENCRYPTION_KEYS_FILE, EVENT_SIGNING_KEYS_FILE.
