HOST=127.0.0.1
PORT=3001
# Private persistent directory; keep it across deployments and back it up.
DATA_DIR=./data
MAX_SESSIONS=20
CONNECTION_CONCURRENCY=5
RESTORE_STAGGER_MS=100
MEDIA_REQUEST_CONCURRENCY=4
MEDIA_SEND_CONCURRENCY=2
SHUTDOWN_TIMEOUT_MS=30000
# Optional advanced signed reconciliation; ordinary API calls need only app/token.
EVENT_SIGNING_KEYS={}
