# Direct Node runs: local connections only by default.
HOST=127.0.0.1
PORT=3001
SESSION_DIR=./data/sessions
APP_CREDENTIALS_FILE=./data/applications.json
MAX_SESSIONS=20

# Docker Compose maps this loopback host port to container port 3001.
# Compose deliberately sets HOST=0.0.0.0 inside the container.
WHATSAPP_HOST_PORT=3001
# CHROME_PATH=/usr/bin/chromium
# CHROME_NO_SANDBOX=true
